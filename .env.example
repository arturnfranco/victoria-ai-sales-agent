# Required application configuration
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional application logging
LOG_LEVEL=INFO

# Scheduling: use "mock" locally or "google" for Google Calendar
SCHEDULING_PROVIDER=mock
SCHEDULING_BLACKOUT_DATES=

# Required when SCHEDULING_PROVIDER=google
GOOGLE_CALENDAR_ID=

# Google OAuth runtime credentials: configure one token source
GOOGLE_OAUTH_TOKEN_FILE=
GOOGLE_OAUTH_TOKEN_JSON=

# Google OAuth authorization: configure one client source
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_OAUTH_CLIENT_JSON=
